#!/sbin/openrc-run

command="/usr/local/open-ui/open-ui"
command_background="yes"
pidfile="/run/open-ui.pid"
directory="/usr/local/open-ui"
name="OpenUI"
description="OpenUI Service"
export OPENUI_DB_FOLDER="${OPENUI_DB_FOLDER:-/etc/open-ui}"
export OPENUI_LOG_FOLDER="${OPENUI_LOG_FOLDER:-/var/log/open-ui}"
export OPENUI_BIN_FOLDER="${OPENUI_BIN_FOLDER:-/usr/local/open-ui/bin}"
export XRAY_VMESS_AEAD_FORCED="${XRAY_VMESS_AEAD_FORCED:-false}"

depend() {
    need net
    after firewall
}
