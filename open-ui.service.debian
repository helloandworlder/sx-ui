[Unit]
Description=OpenUI Service
After=network.target
Wants=network.target

[Service]
EnvironmentFile=-/etc/default/open-ui
Environment="XRAY_VMESS_AEAD_FORCED=false"
Environment="OPENUI_DB_FOLDER=/etc/open-ui"
Environment="OPENUI_LOG_FOLDER=/var/log/open-ui"
Environment="OPENUI_BIN_FOLDER=/usr/local/open-ui/bin"
Type=simple
WorkingDirectory=/usr/local/open-ui/
ExecStart=/usr/local/open-ui/open-ui
ExecReload=kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
